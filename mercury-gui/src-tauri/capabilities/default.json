{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "gh-issue-list",
          "cmd": "gh",
          "sidecar": false,
          "args": [
            "issue",
            "list",
            "--repo",
            { "validator": "^[\\w.-]+/[\\w.-]+$" },
            "--json",
            { "validator": "^[a-zA-Z,]+$" },
            "--limit",
            { "validator": "^[0-9]+$" },
            "--state",
            { "validator": "^(open|closed|all)$" }
          ]
        },
        {
          "name": "gh-pr-list",
          "cmd": "gh",
          "sidecar": false,
          "args": [
            "pr",
            "list",
            "--repo",
            { "validator": "^[\\w.-]+/[\\w.-]+$" },
            "--json",
            { "validator": "^[a-zA-Z,]+$" },
            "--limit",
            { "validator": "^[0-9]+$" },
            "--state",
            { "validator": "^(open|closed|all)$" }
          ]
        }
      ]
    }
  ]
}

{
  "schema_version": 1,
  "_readme": "Ship of Theseus 引擎仓 ↔ 设计库仓 的 id 对应表（Mercury Issue #556）。本文件是该对应关系的唯一真源，人工维护；校验方式与维护步骤见同目录 README.md。只出表、不写引擎消费代码 —— 消费方归 SoT lane（lane 文档 §2 分工矩阵）。",
  "sides": {
    "engine": {
      "repo": "Ship_of_Theseus",
      "root_env": "SOT_ENGINE_REPO",
      "note": "Godot 4 引擎仓，实体数据在 data/**/*.json，一个实体一个文件。"
    },
    "design": {
      "repo": "SoT-fyc-space",
      "root_env": "SOT_DESIGN_REPO",
      "note": "设计库仓。交接界面是 snapshots/*.json（导出脚本产物，数组形式）；不读它的 app/ 应用代码，也不连生产 API。"
    }
  },
  "engine_scope": {
    "data_dir": "data",
    "excluded_paths": {
      "data/runloop": "跑图循环配置文件（act1_config.json / run_config.json），没有 id 字段、不是实体，无从对应。"
    }
  },
  "design_scope": {
    "snapshot_dir": "snapshots",
    "excluded_paths": {
      "snapshots/manifest.json": "导出清单元数据（各实体条数与端点），不是实体表。"
    }
  },
  "reason_codes": {
    "engine_not_implemented": "设计库有该条目，引擎尚未实装同类实体。将来实装后应改成 mappings 条目。",
    "design_not_registered": "引擎有该条目，设计库存在同类实体表但未登记这一条（多为剑士线以外的内容）。",
    "engine_implements_as_field": "两侧都有这件事，但引擎把它实装成了另一个实体的字段而不是独立实体。必须同时给出 engine_carrier 指针（形如 data/classes/kensei.json#sword_qi_config），校验器会核实该文件存在。不许用 engine_not_implemented 顶替 —— 那是错误定性。",
    "engine_no_entity_kind": "引擎侧根本没有这一类实体（设计库的规则条文、判定层等设计/规格层内容）。",
    "design_no_entity_kind": "设计库侧根本没有这一类实体（引擎的 buff、词条、地图、波次等运行时内容）。",
    "no_traceable_correspondence": "两侧都有相近概念，但没有可从数据或双方文档溯源的 id 级对应关系。按 Issue #556 界线，溯源不到就标本码写明原因，不猜。"
  },

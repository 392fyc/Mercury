{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/scope-guard.sh\"",
            "timeout": 5,
            "command_windows": "& bash \"$(& git rev-parse --show-toplevel)/.claude/hooks/scope-guard.sh\""
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/pre-commit-guard.sh\"",
            "timeout": 5,
            "command_windows": "& bash \"$(& git rev-parse --show-toplevel)/.claude/hooks/pre-commit-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/push-guard.sh\"",
            "timeout": 5,
            "command_windows": "& bash \"$(& git rev-parse --show-toplevel)/.claude/hooks/push-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/pr-create-guard.sh\"",
            "timeout": 5,
            "command_windows": "& bash \"$(& git rev-parse --show-toplevel)/.claude/hooks/pr-create-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/pr-merge-guard.sh\"",
            "timeout": 15,
            "command_windows": "& bash \"$(& git rev-parse --show-toplevel)/.claude/hooks/pr-merge-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/adapters/mercury-loop-detector/hook.cjs\"",
            "timeout": 10,
            "command_windows": "& node \"$(& git rev-parse --show-toplevel)/adapters/mercury-loop-detector/hook.cjs\""
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/post-commit-reset.sh\"",
            "timeout": 5,
            "command_windows": "& bash \"$(& git rev-parse --show-toplevel)/.claude/hooks/post-commit-reset.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/session-init.sh\"",
            "timeout": 5,
            "command_windows": "& bash \"$(& git rev-parse --show-toplevel)/.claude/hooks/session-init.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/user-prompt-submit.sh\"",
            "timeout": 5,
            "command_windows": "& bash \"$(& git rev-parse --show-toplevel)/.claude/hooks/user-prompt-submit.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/stop-guard.sh\"",
            "timeout": 10,
            "command_windows": "& bash \"$(& git rev-parse --show-toplevel)/.claude/hooks/stop-guard.sh\""
          }
        ]
      }
    ]
  }
}

.env
.env.*
*.key
*.pem
credentials.json

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# OS
desktop.ini
$RECYCLE.BIN/

# Claude Code
CLAUDE.local.md
.claude/plans/
.claude/hooks/state/
.claude/scheduled_tasks.lock
.mercury/state/*
!.mercury/state/upstream-manifest.json
!.mercury/state/upstream-evaluations.json
.claude/settings.local.json
CLAUDE.md

# Git worktrees (transient, managed by Main Agent)
/.worktrees/

# Leftover state files of the retired pr-flow skill (#672); keep ignored
.pr-flow-*
.mercury/sessions.json
.mercury/transcripts/
.mercury/backups/
# Local runtime state: tool environments, fixtures and probes — never commit
.mercury/tmp/
.mercury/tools/
.mercury/mercury.db
.mercury/mercury.db-wal
.mercury/mercury.db-shm
# 旧版本留下的本机配置，保持忽略以免误提交
mercury.config.json
.claude/current-session.md
.codex/state/

# Autoresearch state (standalone mode, transient)
.research/

# mem0 test venv (Phase A)
.venv-mem0/

# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# PR review agent guide (deployment-specific doc, not committed)
.mercury/docs/guides/argus-review-guide.md

# Private active memory (local-only; exclusion must survive cloning)
/.mercury/memory/

# KB managed separately in parallel directory (D:/Mercury/Mercury_KB), never inside repo
Mercury_KB/

# OMC plugin runtime state (per-user, populated after /plugin install oh-my-claudecode)
.omc/

# playwright-mcp server output sandbox (console logs, storageState exports w/ live cookies) — never commit
.playwright-mcp/
